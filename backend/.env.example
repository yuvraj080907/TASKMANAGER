# Copy this file to .env for local development.
# On Render, add these as Environment Variables instead.

# MongoDB Atlas connection string (REQUIRED for hosting)
MONGO_URI=mongodb+srv://taskmanager:<password>@cluster0.xxxxx.mongodb.net/taskmanager

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Your deployed frontend URL (no trailing slash)
CLIENT_URL=https://yuvraj-taskmanager.netlify.app

# Port (Render sets this automatically)
PORT=5000