# Copy this file to .env for local development.
# On Render, add these as Environment Variables instead.

# Supabase Postgres connection string (project settings -> Database -> Connection string -> URI)
# Use the Transaction pooler format. Replace YOUR_PROJECT_REF and YOUR_SUPABASE_PASSWORD.
# IMPORTANT: URL-encode special characters in the password (@ -> %40, # -> %23, etc.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Your deployed frontend URL (no trailing slash)
CLIENT_URL=https://yuvraj-taskmanager.netlify.app

# Port (Render sets this automatically)
PORT=5000