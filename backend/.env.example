# Copy this file to .env for local development.
# On Render, add these as Environment Variables instead.

# Supabase Postgres connection string (project settings -> Database -> Connection string -> URI)
# Replace YOUR_SUPABASE_PASSWORD in the password section
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR_SUPABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# Your deployed frontend URL (no trailing slash)
CLIENT_URL=https://yuvraj-taskmanager.netlify.app

# Port (Render sets this automatically)
PORT=5000